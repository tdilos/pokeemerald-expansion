PanoIsle_Shrine_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, PanoIsle_Shrine_OnTransition
	.byte 0

PanoIsle_Shrine_OnTransition:
	goto_if_unset FLAG_DEFEATED_ARCHON_NIHILEGO, PanoIsle_Shrine_EventScript_HideWormhole
	goto_if_unset FLAG_DEFEATED_ARCHON_STAKATAKA, PanoIsle_Shrine_EventScript_HideWormhole
	goto_if_unset FLAG_DEFEATED_ARCHON_SOMNIVORE, PanoIsle_Shrine_EventScript_HideWormhole
	@goto_if_set FLAG_BATTLED_TAPU_KOKO, PanoIsle_Shrine_EventScript_HideWormhole
	clearflag FLAG_HIDE_WORMHOLE_TAPU_KOKO
	end

PanoIsle_Shrine_EventScript_HideWormhole:
	setflag FLAG_HIDE_WORMHOLE_TAPU_KOKO
	end


